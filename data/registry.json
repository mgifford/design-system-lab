    {
      "id": "alert-read",
      "component": "alert",
      "intent": "Read alert without relying on color alone",
      "interaction": "read"
    },
    {
      "id": "banner-disclose",
      "component": "banner",
      "intent": "Expand the informational banner",
      "interaction": "keyboard"
    },
    {
      "id": "form-required",
