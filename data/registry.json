  "components": [
    {
      "slug": "accordion",
      "name": "Accordion",
      "group": "Disclosure",
      "summary": "Expand and collapse supporting information without losing keyboard access.",
      "reference": "https://designsystem.digital.gov/components/accordion/",
      "accessibility": "https://designsystem.digital.gov/components/accordion/accessibility-tests/",
      "experiment": "Theme-aware disclosure controls",
      "issues": [
        4577,
        5817,
        5861
      ]
    },
    {
      "slug": "alert",
      "name": "Alert",
      "group": "Messaging",
      "summary": "Communicate status, warnings and errors with meaning beyond color.",
      "reference": "https://designsystem.digital.gov/components/alert/",
      "accessibility": "https://designsystem.digital.gov/components/alert/accessibility-tests/",
      "experiment": "Dark-mode semantic alerts",
      "issues": [
        5069,
        4407
      ]
    },
    {
      "slug": "banner",
      "name": "Banner",
      "group": "Identity",
      "summary": "Distinguish a government-service identity pattern from ordinary site content.",
      "reference": "https://designsystem.digital.gov/components/banner/",
      "accessibility": "https://designsystem.digital.gov/components/banner/accessibility-tests/",
      "experiment": "Theme-aware banner and logical layout",
      "issues": [
        5336,
        6030
      ]
    },
    {
      "slug": "form",
      "name": "Form controls",
      "group": "Forms",
      "summary": "Labels, required controls, validation and legible focus states.",
      "reference": "https://designsystem.digital.gov/components/form/",
      "accessibility": "https://designsystem.digital.gov/components/radio-buttons/accessibility-tests/",
      "experiment": "Native validation and theme-safe focus",
      "issues": [
        6068,
        6080
      ]
    }
  ],
  "scenarios": [
    {
      "id": "accordion-expand",
